# ─── Supabase (Project Settings → API Keys) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ─── App ───────────────────────────────────────────────────────────────────
# Public URL of the app (used for share links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev tools: role switcher, simulation, time warp. MUST be "false" in production.
NEXT_PUBLIC_DEV_TOOLS=true

# Internal login-email domain for phone+password auth (D3). Any domain-looking value works.
PHONE_LOGIN_DOMAIN=phone.waqtpe.app

# Password for seeded test accounts (and the dev role switcher).
SEED_PASSWORD=waqtpe123

# Protects /api/cron/sweep (backup sweep trigger for a Hostinger cron job). Make it long & random.
CRON_SECRET=change-me-to-a-long-random-string

# How often the in-process guarantee sweep runs (ms). Default 5000.
SWEEP_INTERVAL_MS=5000
